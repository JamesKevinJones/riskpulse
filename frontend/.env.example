# Build-time settings for the React desk. Nothing is required for local dev:
# Vite proxies /api and /ws to the backend on 127.0.0.1:8000 (vite.config.js).
# Copy to frontend/.env (gitignored) only to point the UI somewhere else.

# API base path or URL. Default /api (the Vite dev proxy and docker-compose's nginx).
VITE_API_URL=/api
# WebSocket URL. Empty = derived from VITE_API_URL or the page's own host.
VITE_WS_URL=
# true = never call the API; run the in-browser simulator (src/demoEngine.js).
VITE_DEMO_MODE=false
